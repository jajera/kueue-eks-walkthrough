    "lint": "markdownlint-cli2 \"src/**/*.mdx\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/starlight": "^0.42.6",
    "astro": "^7.4.1",
    "sharp": "^0.35.5",
    "starlight-base-path": "^0.2.1"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
